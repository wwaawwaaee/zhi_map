NODE_ENV=development
# Optional explicit application environment; defaults to NODE_ENV.
APP_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=./data/zhijing.db
# Required in production: a 32+ character random value used by future auth adapters.
SESSION_SECRET=change-this-development-secret-to-at-least-32-characters
# Optional browser origin, e.g. https://learn.example.com. Omit for same-origin deployments.
APP_ORIGIN=
# OpenAI-compatible API root, including /v1 when your provider requires it.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=60000
# Required to persist per-session model keys in production. Generate with: npm run keys:generate
DATA_ENCRYPTION_KEY=
# Optional comma-separated exact host allowlist for user-configured model URLs.
AI_ALLOWED_HOSTS=
LOG_LEVEL=info
