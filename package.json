{
  "name": "zhijing",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.9.0" },
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch apps/api/src/index.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "npm run build --workspaces",
    "start": "tsx --env-file-if-exists=.env apps/api/src/index.ts",
    "typecheck": "tsc --build",
    "test": "tsx --test packages/domain/test/*.test.ts apps/api/test/*.test.ts",
    "test:browser": "tsx tests/browser-smoke.ts",
    "db:migrate": "tsx apps/api/src/db/migrate.ts",
    "db:seed": "tsx apps/api/src/db/seed.ts",
    "keys:generate": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('base64'))\""
  },
  "workspaces": ["apps/*", "packages/*"],
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/static": "^8.1.1",
    "better-sqlite3": "^11.8.1",
    "drizzle-orm": "^0.38.4",
    "fastify": "^5.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.0",
    "playwright-core": "^1.55.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
