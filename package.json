{
  "name": "zhijing",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.9.0" },
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "npm run build:web",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --build",
    "test": "py -m pytest backend/tests -q",
    "keys:generate": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('base64'))\"",
    "test:browser": "py backend/tests/browser_smoke.py"
  },
  "workspaces": ["apps/web"],
  "devDependencies": {
    "@types/node": "^22.10.2",
    "playwright-core": "^1.55.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
